# ─── Database (PostgreSQL via Neon) ───────────────────────────────────────────
# Diisi otomatis oleh Vercel/Netlify saat kamu enable database di dashboard.
# JANGAN pernah commit nilai aslinya ke Git!
DATABASE_URL=postgresql://user:password@host/dbname

# ─── Admin Token ──────────────────────────────────────────────────────────────
# Password rahasia untuk halaman admin.html
# Set di: Vercel Dashboard → Project → Settings → Environment Variables
# Gunakan string acak yang kuat, minimal 20 karakter.
ADMIN_TOKEN=ganti-dengan-token-rahasia-anda

# ─── Super Admin Token (opsional) ─────────────────────────────────────────────
# Jika diset, token ini memberi akses penuh (termasuk hapus produk, setup-db).
# Admin biasa (ADMIN_TOKEN) hanya bisa lihat pesanan & konfirmasi.
# Biarkan kosong jika kamu hanya punya 1 level admin.
SUPER_ADMIN_TOKEN=

# ─── Fonnte (WhatsApp Notification) ───────────────────────────────────────────
# Token API dari fonnte.com untuk kirim notif WA ke admin saat ada pesanan baru.
FONNTE_TOKEN=ganti-dengan-token-fonnte-anda

# ─── Admin WA Number ──────────────────────────────────────────────────────────
# Nomor WA admin (format internasional tanpa +, misal: 6281234567890)
# Bisa lebih dari 1, pisahkan dengan koma: 6281234,6285678
ADMIN_WA=6281234567890

# ─── Digiflazz (Top-up Pulsa & Data Digital) ──────────────────────────────────
# Daftar di https://digiflazz.com — ambil credentials di menu Pengaturan → API
DIGIFLAZZ_USERNAME=username-digiflazz-kamu
DIGIFLAZZ_API_KEY=api-key-production-digiflazz

# Set "true" untuk mode testing (transaksi tidak nyata, tidak memotong saldo)
# WAJIB "false" di production setelah akun verified!
DIGIFLAZZ_TESTING=false

# --- Markup Harga Digital (Pulsa & Paket Data) --------------------------------
# Harga jual ke pelanggan = harga modal Digiflazz + markup
# Pelanggan TIDAK pernah lihat harga modal.

# MARKUP_PERCENT : persentase keuntungan (default: 5)
#   Contoh: 5 ? modal Rp 10.000 ? jual Rp 10.500
MARKUP_PERCENT=5

# MARKUP_FLAT    : tambahan nominal flat per produk (default: 0)
#   Contoh: 500 ? setiap produk tambah Rp 500
MARKUP_FLAT=0

# MARKUP_ROUND   : pembulatan harga ke atas (default: 100)
#   Contoh: 500 ? Rp 10.450 dibulatkan ke Rp 10.500
#   Gunakan 1000 untuk pembulatan ke ribuan
MARKUP_ROUND=100
